{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":preserveSemverRanges"
  ],
  "minimumReleaseAge": "2 days",
  "packageRules": [
    {
      "description": "Bump algosdk ranges in examples so they stay in lockstep with the SDK's pinned devDependency",
      "matchManagers": ["npm"],
      "matchPackageNames": ["algosdk"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Group all non-major npm dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Separate PR for pnpm package manager updates",
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Pin Node.js to v22.x in GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["node"],
      "allowedVersions": "22.x"
    },
    {
      "description": "Pin @types/node to v22.x",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "22.x"
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "schedule": ["before 3am on Monday"],
  "timezone": "America/New_York",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "semanticCommits": "enabled"
}
